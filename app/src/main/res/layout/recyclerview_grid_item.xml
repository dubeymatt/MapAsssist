<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="156dp" android:layout_margin="5dp" app:cardBackgroundColor="@color/surface_container" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/outline_variant" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:id="@+id/map_number_badge" android:layout_width="60dp" android:layout_height="60dp" android:background="@drawable/file_icon_background" android:gravity="center" android:maxLines="2" android:padding="4dp" android:textColor="@color/primary" android:textSize="18sp" android:textStyle="bold" /><LinearLayout android:id="@+id/card_actions" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginStart="8dp" android:orientation="horizontal"><ImageButton android:id="@+id/download_card" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="Download DNC image" android:src="@drawable/ic_download"/><ImageButton android:id="@+id/share_card" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="Share DNC image" android:src="@drawable/ic_share"/></LinearLayout></LinearLayout>
        <TextView android:id="@+id/textViewTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:ellipsize="end" android:maxLines="1" android:textAppearance="@style/TextAppearance.MapAssist.FileTitle" />
        <TextView android:id="@+id/textViewContent" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:visibility="gone" />
        <ImageButton android:id="@+id/delete_card" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="end" android:background="@android:color/transparent" android:contentDescription="Delete DNC" android:src="@drawable/ic_delete" android:visibility="gone" />
        <TextView android:id="@+id/textViewDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textAppearance="@style/TextAppearance.MapAssist.FileMeta" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
