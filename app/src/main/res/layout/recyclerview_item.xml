<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" app:cardBackgroundColor="@color/surface_container" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/outline_variant" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
        <TextView android:id="@+id/map_number_badge" android:layout_width="60dp" android:layout_height="60dp" android:background="@drawable/file_icon_background" android:gravity="center" android:maxLines="2" android:padding="4dp" android:textColor="@color/primary" android:textSize="18sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/textViewTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textAppearance="@style/TextAppearance.MapAssist.FileTitle" />
            <TextView android:id="@+id/textViewContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
            <TextView android:id="@+id/textViewDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textAppearance="@style/TextAppearance.MapAssist.FileMeta" />
        </LinearLayout>
        <ImageButton android:id="@+id/delete_card" android:layout_width="40dp" android:layout_height="48dp" android:background="@android:color/transparent" android:contentDescription="Delete DNC" android:src="@drawable/ic_delete" android:visibility="gone" />
        <ImageButton android:id="@+id/download_card" android:layout_width="40dp" android:layout_height="48dp" android:background="@android:color/transparent" android:contentDescription="Download DNC image" android:src="@drawable/ic_download" />
        <ImageButton android:id="@+id/share_card" android:layout_width="40dp" android:layout_height="48dp" android:background="@android:color/transparent" android:contentDescription="Share DNC image" android:src="@drawable/ic_share" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
