<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbarStyle="outsideOverlay" android:scrollbars="vertical">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="12dp" android:paddingEnd="20dp" android:paddingBottom="108dp">
    <com.google.android.material.card.MaterialCardView android:id="@+id/shared_sync_attention_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:visibility="gone" app:cardCornerRadius="16dp" app:cardElevation="0dp">
      <TextView android:id="@+id/shared_sync_attention_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp" android:textAppearance="@style/TextAppearance.MapAssist.Body"/>
    </com.google.android.material.card.MaterialCardView>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Google account" android:textAppearance="@style/TextAppearance.MapAssist.Headline"/>
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="@color/surface_container" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/outline_variant" app:strokeWidth="1dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
          <com.google.android.material.imageview.ShapeableImageView android:id="@+id/google_account_avatar" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginEnd="12dp" android:visibility="invisible" app:shapeAppearanceOverlay="@style/ShapeAppearance.MapAssist.Circle"/>
          <TextView android:id="@+id/google_account_status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textAppearance="@style/TextAppearance.MapAssist.Body"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
          <com.google.android.material.button.MaterialButton android:id="@+id/google_account_help_button" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Help" app:icon="@drawable/ic_help"/>
          <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
          <com.google.android.material.button.MaterialButton android:id="@+id/google_account_button" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Sign in with Google" app:icon="@drawable/ic_cloud_backup"/>
          <com.google.android.material.button.MaterialButton android:id="@+id/google_drive_disconnect_button" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="4dp" android:text="Disconnect" app:icon="@drawable/ic_logout"/>
        </LinearLayout>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Appearance" android:textAppearance="@style/TextAppearance.MapAssist.Headline"/>
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="@color/surface_container" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/outline_variant" app:strokeWidth="1dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="10dp" android:paddingEnd="16dp" android:paddingBottom="16dp">
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/dark_mode_switch" android:layout_width="match_parent" android:layout_height="44dp" android:text="Dark mode"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/colours_button" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" android:text="Colours" app:icon="@drawable/ic_edit"/>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Shared library" android:textAppearance="@style/TextAppearance.MapAssist.Headline"/>
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="@color/surface_container" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/outline_variant" app:strokeWidth="1dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/shared_library_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.MapAssist.Body"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical">
          <com.google.android.material.button.MaterialButton android:id="@+id/create_shared_library_button" android:layout_width="match_parent" android:layout_height="44dp" android:text="Create" app:icon="@drawable/ic_cloud_backup"/>
          <com.google.android.material.button.MaterialButton android:id="@+id/join_shared_library_button" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" android:text="Join" app:icon="@drawable/ic_document"/>
        </LinearLayout>
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/shared_auto_sync_switch" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="4dp" android:text="Automatically sync changes"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/shared_sync_button" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="4dp" android:text="Sync shared library" app:icon="@drawable/ic_cloud_backup"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/disconnect_shared_library_button" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginTop="2dp" android:text="Leave shared library" app:icon="@drawable/ic_logout"/>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Backups" android:textAppearance="@style/TextAppearance.MapAssist.Headline"/>
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="@color/surface_container" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/outline_variant" app:strokeWidth="1dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Local backup" android:textAppearance="@style/TextAppearance.MapAssist.FileTitle"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Export or restore a spreadsheet on this device." android:textAppearance="@style/TextAppearance.MapAssist.Body"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="end" android:orientation="horizontal">
          <com.google.android.material.button.MaterialButton android:id="@+id/import_button" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Import" app:icon="@drawable/ic_document"/>
          <com.google.android.material.button.MaterialButton android:id="@+id/export_button" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="8dp" android:text="Export" app:icon="@drawable/ic_download"/>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/open_downloads_button" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginTop="2dp" android:text="Open Download Folder" app:icon="@drawable/ic_folder"/>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="@color/surface_container" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/outline_variant" app:strokeWidth="1dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Google Drive backup" android:textAppearance="@style/TextAppearance.MapAssist.FileTitle"/>
        <TextView android:id="@+id/google_drive_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textAppearance="@style/TextAppearance.MapAssist.Body"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/google_drive_sync_button" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="10dp" android:text="Sync now to Google Drive" app:icon="@drawable/ic_cloud_backup"/>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
  </LinearLayout>
</androidx.core.widget.NestedScrollView>
