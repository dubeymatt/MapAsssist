<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <TextView
        android:id="@+id/maps_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Maps"
        android:textAppearance="@style/TextAppearance.MapAssist.Headline"
        app:layout_constraintEnd_toStartOf="@id/maps_filter_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/maps_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="View and share territory maps"
        android:textAppearance="@style/TextAppearance.MapAssist.Body"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/maps_title" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/maps_filter_button"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="Sort maps"
        app:icon="@drawable/ic_filter"
        app:layout_constraintBottom_toBottomOf="@id/maps_title"
        app:layout_constraintEnd_toStartOf="@id/maps_help_button"
        app:layout_constraintTop_toTopOf="@id/maps_title" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/maps_help_button"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="How to add maps"
        app:icon="@drawable/ic_help"
        app:layout_constraintBottom_toBottomOf="@id/maps_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/maps_title" />
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/maps_refresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/maps_subtitle">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/maps_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="vertical" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <LinearLayout
        android:id="@+id/maps_empty_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/maps_subtitle">
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_map"
            android:tint="@color/primary" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="No maps yet"
            android:textAppearance="@style/TextAppearance.MapAssist.EmptyTitle" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Add image files to Downloads/Map Assist/Maps.\nUse the map number as the filename, for example 30.png."
            android:textAppearance="@style/TextAppearance.MapAssist.Body" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
