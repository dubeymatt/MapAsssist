<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface_container"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/outline_variant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:clipToOutline="true"
            android:background="@drawable/map_thumbnail_background">
            <ImageView
                android:id="@+id/map_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:contentDescription="Map preview"
                android:scaleType="centerCrop" />
            <TextView
                android:id="@+id/map_placeholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="?"
                android:textColor="@color/on_surface_variant"
                android:textSize="64sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/map_number"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/file_icon_background"
                android:gravity="center"
                android:maxLines="2"
                android:padding="3dp"
                android:textColor="@color/primary"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/map_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.MapAssist.FileTitle" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="end"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/share_map_button"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="Share map"
                app:icon="@drawable/ic_share"
                app:iconTint="@color/on_surface" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/share_map_dnc_button"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="Share map and DNC card"
                app:icon="@drawable/ic_document"
                app:iconTint="@color/on_surface" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
