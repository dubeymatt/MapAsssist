<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp">
    <ImageView android:id="@+id/drag_handle" android:layout_width="20dp" android:layout_height="48dp" android:contentDescription="Reorder row" android:src="@drawable/ic_drag_handle" android:visibility="gone" />
    <com.google.android.material.textfield.TextInputLayout android:layout_width="84dp" android:layout_height="wrap_content"><com.google.android.material.textfield.TextInputEditText android:id="@+id/entry_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="MM/YY" android:inputType="text" android:maxLength="5" /></com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_weight="1.2"><com.google.android.material.textfield.TextInputEditText android:id="@+id/entry_address" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Address" /></com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_weight="0.8"><com.google.android.material.textfield.TextInputEditText android:id="@+id/entry_supporting_information" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Supporting information" /></com.google.android.material.textfield.TextInputLayout>
    <ImageButton android:id="@+id/delete_entry" android:layout_width="40dp" android:layout_height="48dp" android:background="@android:color/transparent" android:contentDescription="Delete row" android:src="@drawable/ic_delete" android:visibility="gone" />
</LinearLayout>
