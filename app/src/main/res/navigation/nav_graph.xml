<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/FirstFragment">

    <fragment
        android:id="@+id/FirstFragment"
        android:name="com.example.mapasssist.FirstFragment"
        android:label="@string/first_fragment_label"
        tools:layout="@layout/fragment_first">

        <action
            android:id="@+id/action_FirstFragment_to_SecondFragment"
            app:destination="@id/SecondFragment" />
    </fragment>
    <fragment
        android:id="@+id/SecondFragment"
        android:name="com.example.mapasssist.SecondFragment"
        android:label="@string/second_fragment_label"
        tools:layout="@layout/fragment_second">

        <argument
            android:name="textFileId"
            app:argType="integer"
            android:defaultValue="-1" />

        <action
            android:id="@+id/action_SecondFragment_to_FirstFragment"
            app:destination="@id/FirstFragment" />
    </fragment>
    <fragment android:id="@+id/SettingsFragment" android:name="com.example.mapasssist.SettingsFragment" android:label="Settings" tools:layout="@layout/fragment_settings" />
    <fragment android:id="@+id/MapsFragment" android:name="com.example.mapasssist.MapsFragment" android:label="Maps" tools:layout="@layout/fragment_maps">
        <action android:id="@+id/action_MapsFragment_to_MapViewerFragment" app:destination="@id/MapViewerFragment" />
    </fragment>
    <fragment android:id="@+id/MapViewerFragment" android:name="com.example.mapasssist.MapViewerFragment" android:label="Map" tools:layout="@layout/fragment_map_viewer">
        <argument android:name="imageUri" app:argType="string" />
        <argument android:name="imageName" app:argType="string" android:defaultValue="Map" />
    </fragment>
</navigation>
